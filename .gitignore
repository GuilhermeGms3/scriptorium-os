# Corpus pipeline transactional work areas (source snapshots and generated datasets are tracked)
corpora/.staging/
generated/corpora/*/.staging/
corpora/source/stepbible-tagnt/.acquire-*/
generated/corpora/stepbible-tagnt/.import-*/
generated/corpora/stepbible-tagnt/.previous-*/
generated/corpora/stepbible-tagnt/.import.lock

# Large reproducible corpus indexes (manifests remain tracked; rebuild with corpus:index)
public/corpus-packages/*.sqlite3
public/corpus-packages/**/*.sqlite3

# The small curated knowledge snapshot is intentionally tracked so a clone can
# inspect the current graph without rebuilding it.

