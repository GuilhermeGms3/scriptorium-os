{"schemaVersion":2,"corpusId":"king-james-version","editionId":"king-james-version-2026-09-26","packageId":"pkg-ebible-kjv-2026-09-26","datasetId":"dataset:king-james-version:2026-09-26:67561758cf58d9e767e89226a99171dba722579157d3894767c2f27538bcb38e","sourceArtifactId":"artifact:ebible:eng-kjv:usfm:2026-09-26","sourcePath":"20-PSAeng-kjv.usfm#chapter=120","bookId":"psalms","chapter":120,"verses":[{"ref":{"bookId":"psalms","chapter":120,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"king-james-version-2026-09-26":"In my distress I cried unto the LORD, and he heard me."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"king-james-version-2026-09-26":"Deliver my soul, O LORD, from lying lips, and from a deceitful tongue."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"king-james-version-2026-09-26":"What shall be given unto thee? or what shall be done unto thee, thou false tongue?"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"king-james-version-2026-09-26":"Sharp arrows of the mighty, with coals of juniper."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"king-james-version-2026-09-26":"Woe is me, that I sojourn in Mesech, that I dwell in the tents of Kedar!"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"king-james-version-2026-09-26":"My soul hath long dwelt with him that hateth peace."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"king-james-version-2026-09-26":"I am for peace: but when I speak, they are for war."}}]}
