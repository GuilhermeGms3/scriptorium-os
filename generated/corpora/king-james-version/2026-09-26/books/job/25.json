{"schemaVersion":2,"corpusId":"king-james-version","editionId":"king-james-version-2026-09-26","packageId":"pkg-ebible-kjv-2026-09-26","datasetId":"dataset:king-james-version:2026-09-26:67561758cf58d9e767e89226a99171dba722579157d3894767c2f27538bcb38e","sourceArtifactId":"artifact:ebible:eng-kjv:usfm:2026-09-26","sourcePath":"19-JOBeng-kjv.usfm#chapter=25","bookId":"job","chapter":25,"verses":[{"ref":{"bookId":"job","chapter":25,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"king-james-version-2026-09-26":"Then answered Bildad the Shuhite, and said,"}},{"ref":{"bookId":"job","chapter":25,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"king-james-version-2026-09-26":"Dominion and fear are with him, he maketh peace in his high places."}},{"ref":{"bookId":"job","chapter":25,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"king-james-version-2026-09-26":"Is there any number of his armies? and upon whom doth not his light arise?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"king-james-version-2026-09-26":"How then can man be justified with God? or how can he be clean that is born of a woman?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"king-james-version-2026-09-26":"Behold even to the moon, and it shineth not; yea, the stars are not pure in his sight."}},{"ref":{"bookId":"job","chapter":25,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"king-james-version-2026-09-26":"How much less man, that is a worm? and the son of man, which is a worm?"}}]}
