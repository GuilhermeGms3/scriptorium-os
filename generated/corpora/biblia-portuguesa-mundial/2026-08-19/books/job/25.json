{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"19-JOBporbrbsl.usfm#chapter=25","bookId":"job","chapter":25,"verses":[{"ref":{"bookId":"job","chapter":25,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Então Bildade, o suíta, respondeu:"}},{"ref":{"bookId":"job","chapter":25,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"“O domínio e o temor estão com ele. Ele estabelece a paz em suas alturas."}},{"ref":{"bookId":"job","chapter":25,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Podem os seus exércitos ser contados? Sobre quem não se levanta a sua luz?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Como, então, pode o homem ser justo diante de Deus? Ou como pode ser puro aquele que nasce de mulher?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Eis que nem mesmo a lua tem brilho, e as estrelas não são puras aos seus olhos;"}},{"ref":{"bookId":"job","chapter":25,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"quanto menos o homem, que é um verme, e o filho do homem, que é um verme!”"}}]}
