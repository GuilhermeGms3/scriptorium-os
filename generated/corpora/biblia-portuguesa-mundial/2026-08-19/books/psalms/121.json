{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"20-PSAporbrbsl.usfm#chapter=121","bookId":"psalms","chapter":121,"verses":[{"ref":{"bookId":"psalms","chapter":121,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Levantarei os meus olhos para os montes. De onde vem o meu socorro?"}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O meu socorro vem do SENHOR, que fez o céu e a terra."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ele não permitirá que o seu pé vacile. Aquele que o guarda não cochilará."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Eis que aquele que guarda Israel não cochilará nem dormirá."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O SENHOR é o seu guarda. O SENHOR é a sua sombra à sua mão direita."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O sol não lhe fará mal de dia, nem a lua de noite."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O SENHOR o guardará de todo o mal. Ele guardará a sua alma."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O SENHOR guardará a sua saída e a sua entrada, desde agora e para todo o sempre."}}]}
