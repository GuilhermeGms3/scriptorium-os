{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"20-PSAporbrbsl.usfm#chapter=130","bookId":"psalms","chapter":130,"verses":[{"ref":{"bookId":"psalms","chapter":130,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Das profundezas clamei a ti, SENHOR."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Senhor, ouve a minha voz. Que os teus ouvidos estejam atentos à voz das minhas súplicas."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Se tu, SENHOR, mantivesses um registro dos pecados, Senhor, quem poderia subsistir?"}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Mas contigo há perdão, por isso és temido."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Eu aguardo o SENHOR. Minha alma aguarda. Eu espero na sua palavra."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Minha alma anseia pelo Senhor mais do que os sentinelas anseiam pela manhã, mais do que os sentinelas pela manhã."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Israel, espere no SENHOR, pois com o SENHOR há amor leal. Com ele há abundante redenção."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ele redimirá Israel de todos os seus pecados."}}]}
