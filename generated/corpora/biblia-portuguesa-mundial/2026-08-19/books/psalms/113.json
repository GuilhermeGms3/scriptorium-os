{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"20-PSAporbrbsl.usfm#chapter=113","bookId":"psalms","chapter":113,"verses":[{"ref":{"bookId":"psalms","chapter":113,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Louvem ao SENHOR! Louvem, servos do SENHOR, louvem o nome do SENHOR."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Bendito seja o nome do SENHOR, desde agora e para sempre."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Desde o nascer do sol até o seu poente, seja louvado o nome do SENHOR."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O SENHOR está exaltado acima de todas as nações, e a sua glória acima dos céus."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Quem é como o SENHOR, o nosso Deus, que tem o seu trono nas alturas,"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"que se inclina para ver o que há nos céus e na terra?"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ele levanta o pobre do pó, e ergue o necessitado do monte de cinzas,"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-portuguesa-mundial-2026-08-19":"para assentá-lo com os príncipes, sim, com os príncipes do seu povo."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ele estabelece a mulher estéril em seu lar como uma alegre mãe de filhos. Louvem ao SENHOR!"}}]}
