{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"20-PSAporbrbsl.usfm#chapter=120","bookId":"psalms","chapter":120,"verses":[{"ref":{"bookId":"psalms","chapter":120,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Em minha angústia, clamei ao SENHOR. Ele me respondeu."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Livra a minha alma, SENHOR, dos lábios mentirosos, de uma língua enganadora."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O que lhe será dado, e o que mais lhe será feito, ó língua enganadora?"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Flechas afiadas do valente, com brasas de zimbro."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ai de mim, que vivo em Meseque, que habito entre as tendas de Quedar!"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Minha alma já habitou tempo demais com aquele que odeia a paz."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Eu sou pela paz, mas quando eu falo, eles são pela guerra."}}]}
