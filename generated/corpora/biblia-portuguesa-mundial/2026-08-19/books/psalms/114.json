{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"20-PSAporbrbsl.usfm#chapter=114","bookId":"psalms","chapter":114,"verses":[{"ref":{"bookId":"psalms","chapter":114,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Quando Israel saiu do Egito, a casa de Jacó do meio de um povo de língua estrangeira,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Judá tornou-se o seu santuário, Israel o seu domínio."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O mar viu isso e fugiu. O Jordão retrocedeu."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os montes saltaram como carneiros, as colinas como cordeiros."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O que houve, ó mar, para que você fugisse? E você, Jordão, para que retrocedesse?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"E vocês, montes, para que saltassem como carneiros? E vocês, colinas, como cordeiros?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Trema, ó terra, na presença do Senhor, na presença do Deus de Jacó,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-portuguesa-mundial-2026-08-19":"que transformou a rocha em um lago de água, a pederneira em uma fonte de águas."}}]}
