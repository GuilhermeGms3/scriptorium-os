{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"14-1CHporbrbsl.usfm#chapter=1","bookId":"1-chronicles","chapter":1,"verses":[{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Adão, Sete, Enos,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Cainã, Maalalel, Jarede,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Enoque, Matusalém, Lameque,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Noé, Sem, Cam e Jafé."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Jafé: Gômer, Magogue, Madai, Javã, Tubal, Meseque e Tiras."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Gômer: Asquenaz, Difate e Togarma."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Javã: Elisá, Társis, Quitim e Rodanim."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Cam: Cuxe, Mizraim, Pute e Canaã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Cuxe: Sebá, Havilá, Sabtá, Raamá e Sabteca. Os filhos de Raamá: Sabá e Dedã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":10,"verseEnd":10},"verse":10,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Cuxe gerou Ninrode. Ele começou a ser poderoso na terra."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":11,"verseEnd":11},"verse":11,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Mizraim gerou Ludim, Anamim, Leabim, Naftuim,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":12,"verseEnd":12},"verse":12,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Patrusim, Casluim (de onde vieram os filisteus) e Caftorim."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":13,"verseEnd":13},"verse":13,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Canaã gerou Sidom, seu primogênito, Hete,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":14,"verseEnd":14},"verse":14,"translations":{"biblia-portuguesa-mundial-2026-08-19":"o jebuseu, o amorreu, o girgaseu,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":15,"verseEnd":15},"verse":15,"translations":{"biblia-portuguesa-mundial-2026-08-19":"o heveu, o arqueu, o sineu,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":16,"verseEnd":16},"verse":16,"translations":{"biblia-portuguesa-mundial-2026-08-19":"o arvadeu, o zemareu e o hamateu."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":17,"verseEnd":17},"verse":17,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Sem: Elão, Assur, Arfaxade, Lude, Arã, Uz, Hul, Geter e Meseque."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":18,"verseEnd":18},"verse":18,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Arfaxade gerou Selá, e Selá gerou Héber."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":19,"verseEnd":19},"verse":19,"translations":{"biblia-portuguesa-mundial-2026-08-19":"A Héber nasceram dois filhos: o nome de um foi Pelegue, pois em seus dias a terra foi dividida; e o nome de seu irmão era Joctã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":20,"verseEnd":20},"verse":20,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Joctã gerou Almodá, Selefe, Hazarmavé, Jerá,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":21,"verseEnd":21},"verse":21,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Hadorão, Uzal, Dicla,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":22,"verseEnd":22},"verse":22,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ebal, Abimael, Sabá,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":23,"verseEnd":23},"verse":23,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ofir, Havilá e Jobabe. Todos estes foram filhos de Joctã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":24,"verseEnd":24},"verse":24,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Sem, Arfaxade, Selá,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":25,"verseEnd":25},"verse":25,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Héber, Pelegue, Reú,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":26,"verseEnd":26},"verse":26,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Serugue, Naor, Terá,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":27,"verseEnd":27},"verse":27,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Abrão (também chamado Abraão)."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":28,"verseEnd":28},"verse":28,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Abraão: Isaque e Ismael."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":29,"verseEnd":29},"verse":29,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Estas são as suas gerações: o primogênito de Ismael, Nebaiote; depois Quedar, Adbeel, Mibsão,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":30,"verseEnd":30},"verse":30,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Misma, Dumá, Massá, Hadade, Temá,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":31,"verseEnd":31},"verse":31,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Jetur, Nafis e Quedemá. Estes são os filhos de Ismael."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":32,"verseEnd":32},"verse":32,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Quetura, concubina de Abraão: ela deu à luz Zinrã, Jocsã, Medã, Midiã, Isbaque e Suá. Os filhos de Jocsã: Sabá e Dedã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":33,"verseEnd":33},"verse":33,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Midiã: Efá, Efer, Enoque, Abida e Eldaa. Todos estes foram filhos de Quetura."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":34,"verseEnd":34},"verse":34,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Abraão gerou Isaque. Os filhos de Isaque: Esaú e Israel."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":35,"verseEnd":35},"verse":35,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Esaú: Elifaz, Reuel, Jeús, Jalão e Corá."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":36,"verseEnd":36},"verse":36,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Elifaz: Temã, Omar, Zefi, Gaetã, Quenaz, Timna e Amaleque."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":37,"verseEnd":37},"verse":37,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Reuel: Naate, Zerá, Samá e Mizá."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":38,"verseEnd":38},"verse":38,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Seir: Lotã, Sobal, Zibeão, Aná, Disom, Ezer e Disã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":39,"verseEnd":39},"verse":39,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Lotã: Hori e Homã; e Timna era irmã de Lotã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":40,"verseEnd":40},"verse":40,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Sobal: Aliã, Manaate, Ebal, Sefi e Onã. Os filhos de Zibeão: Aiá e Aná."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":41,"verseEnd":41},"verse":41,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O filho de Aná: Disom. Os filhos de Disom: Hanrão, Esbã, Itrã e Querã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":42,"verseEnd":42},"verse":42,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Ezer: Bilã, Zaavã e Jaacã. Os filhos de Disã: Uz e Arã."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":43,"verseEnd":43},"verse":43,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ora, estes são os reis que reinaram na terra de Edom, antes que qualquer rei reinasse sobre os filhos de Israel: Belá, filho de Beor; e o nome de sua cidade era Dinabá."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":44,"verseEnd":44},"verse":44,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Belá morreu, e Jobabe, filho de Zerá, de Bozra, reinou em seu lugar."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":45,"verseEnd":45},"verse":45,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Jobabe morreu, e Husão, da terra dos temanitas, reinou em seu lugar."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":46,"verseEnd":46},"verse":46,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Husão morreu, e Hadade, filho de Bedade, que derrotou Midiã no campo de Moabe, reinou em seu lugar; e o nome de sua cidade era Avite."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":47,"verseEnd":47},"verse":47,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Hadade morreu, e Sanlá, de Masreca, reinou em seu lugar."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":48,"verseEnd":48},"verse":48,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Sanlá morreu, e Saul, de Reobote, junto ao Rio, reinou em seu lugar."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":49,"verseEnd":49},"verse":49,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Saul morreu, e Baal-Hanã, filho de Acbor, reinou em seu lugar."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":50,"verseEnd":50},"verse":50,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Baal-Hanã morreu, e Hadade reinou em seu lugar; e o nome de sua cidade era Pai. O nome de sua mulher era Meetabel, filha de Matrede, filha de Me-Zaabe."}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":51,"verseEnd":51},"verse":51,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Então Hadade morreu. Os chefes de Edom foram: o chefe Timna, o chefe Aliá, o chefe Jetete,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":52,"verseEnd":52},"verse":52,"translations":{"biblia-portuguesa-mundial-2026-08-19":"o chefe Oolibama, o chefe Elá, o chefe Pinom,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":53,"verseEnd":53},"verse":53,"translations":{"biblia-portuguesa-mundial-2026-08-19":"o chefe Quenaz, o chefe Temã, o chefe Mibzar,"}},{"ref":{"bookId":"1-chronicles","chapter":1,"verseStart":54,"verseEnd":54},"verse":54,"translations":{"biblia-portuguesa-mundial-2026-08-19":"o chefe Magdiel e o chefe Irão. Estes são os chefes de Edom."}}]}
