{"schemaVersion":2,"corpusId":"biblia-portuguesa-mundial","editionId":"biblia-portuguesa-mundial-2026-08-19","packageId":"pkg-ebible-bpm-2026-08-19","datasetId":"dataset:biblia-portuguesa-mundial:2026-08-19:52eae6cc562494ac9d68e618e271ff764628dec34017cc2a4f37fd446f3e66bd","sourceArtifactId":"artifact:ebible:porbrbsl:usfm:2026-08-19","sourcePath":"14-1CHporbrbsl.usfm#chapter=8","bookId":"1-chronicles","chapter":8,"verses":[{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Benjamim gerou a Bela, seu primogênito, Asbel o segundo, Aará o terceiro,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Noá o quarto, e Rafa o quinto."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Bela foram: Adar, Gera, Abiúde,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Abisua, Naamã, Aoá,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Gera, Sefufã e Hurão."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Estes são os filhos de Eúde. Estes são os chefes de casas paternas dos habitantes de Geba, que foram levados cativos para Manaate:"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Naamã, Aías e Gera, que os levou cativos; e ele gerou a Uzá e a Aiúde."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Saaraim gerou filhos nos campos de Moabe, depois de tê-las despedido. Husim e Baara eram suas mulheres."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"biblia-portuguesa-mundial-2026-08-19":"De Hodes, sua mulher, ele gerou a Jobabe, Zíbia, Mesa, Malcã,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":10,"verseEnd":10},"verse":10,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Jeús, Saquia e Mirma. Estes foram seus filhos, chefes de casas paternas."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":11,"verseEnd":11},"verse":11,"translations":{"biblia-portuguesa-mundial-2026-08-19":"De Husim, ele gerou a Abitube e Elpaal."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":12,"verseEnd":12},"verse":12,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Elpaal: Éber, Misã e Semede, que edificou Ono e Lode, com as suas vilas;"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":13,"verseEnd":13},"verse":13,"translations":{"biblia-portuguesa-mundial-2026-08-19":"e Berias e Sema, que foram chefes de casas paternas dos habitantes de Aijalom, os quais puseram em fuga os habitantes de Gate;"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":14,"verseEnd":14},"verse":14,"translations":{"biblia-portuguesa-mundial-2026-08-19":"e Aio, Sasaque, Jeremote,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":15,"verseEnd":15},"verse":15,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Zebadias, Arade, Éder,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":16,"verseEnd":16},"verse":16,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Micael, Ispa, Joa, os filhos de Berias,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":17,"verseEnd":17},"verse":17,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Zebadias, Mesulão, Hizqui, Héber,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":18,"verseEnd":18},"verse":18,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ismerai, Izlias, Jobabe, os filhos de Elpaal,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":19,"verseEnd":19},"verse":19,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Jaquim, Zicri, Zabdi,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":20,"verseEnd":20},"verse":20,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Elienai, Ziletai, Eliel,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":21,"verseEnd":21},"verse":21,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Adaías, Beraías, Sinrate, os filhos de Simei,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":22,"verseEnd":22},"verse":22,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ispã, Éber, Eliel,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":23,"verseEnd":23},"verse":23,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Abdom, Zicri, Hanã,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":24,"verseEnd":24},"verse":24,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Hananias, Elão, Antotijas,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":25,"verseEnd":25},"verse":25,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ifdeias, Penuel, os filhos de Sasaque,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":26,"verseEnd":26},"verse":26,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Sanserai, Searias, Atalias,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":27,"verseEnd":27},"verse":27,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Jaaresias, Elias, Zicri e os filhos de Jeroão."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":28,"verseEnd":28},"verse":28,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Estes foram chefes de casas paternas segundo as suas gerações, homens principais. Estes habitavam em Jerusalém."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":29,"verseEnd":29},"verse":29,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O pai de Gibeão, cuja mulher se chamava Maaca, habitou em Gibeão"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":30,"verseEnd":30},"verse":30,"translations":{"biblia-portuguesa-mundial-2026-08-19":"com seu filho primogênito, Abdom, e Zur, Quis, Baal, Nadabe,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":31,"verseEnd":31},"verse":31,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Gedor, Aio, Zequer,"}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":32,"verseEnd":32},"verse":32,"translations":{"biblia-portuguesa-mundial-2026-08-19":"e Miclote, que gerou a Simeia. Eles também habitavam com suas famílias em Jerusalém, perto de seus parentes."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":33,"verseEnd":33},"verse":33,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Ner gerou a Quis. Quis gerou a Saul. Saul gerou a Jônatas, Malquisua, Abinadabe e Esbaal."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":34,"verseEnd":34},"verse":34,"translations":{"biblia-portuguesa-mundial-2026-08-19":"O filho de Jônatas foi Meribe-Baal. Meribe-Baal gerou a Mica."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":35,"verseEnd":35},"verse":35,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Mica: Pitom, Meleque, Tareia e Acaz."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":36,"verseEnd":36},"verse":36,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Acaz gerou a Jeoada. Jeoada gerou a Alemete, Azmavete e Zinri. Zinri gerou a Moza."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":37,"verseEnd":37},"verse":37,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Moza gerou a Binea. Rafa foi seu filho, Eleasa seu filho, e Azel seu filho."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":38,"verseEnd":38},"verse":38,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Azel teve seis filhos, cujos nomes são estes: Azricão, Bocru, Ismael, Searias, Obadias e Hanã. Todos estes foram filhos de Azel."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":39,"verseEnd":39},"verse":39,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Eseque, seu irmão: Ulão, seu primogênito, Jeús o segundo, e Elifelete o terceiro."}},{"ref":{"bookId":"1-chronicles","chapter":8,"verseStart":40,"verseEnd":40},"verse":40,"translations":{"biblia-portuguesa-mundial-2026-08-19":"Os filhos de Ulão foram homens valentes, arqueiros, e tiveram muitos filhos e netos, cento e cinquenta. Todos estes foram dos filhos de Benjamim."}}]}
