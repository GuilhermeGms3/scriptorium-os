{"schemaVersion":2,"corpusId":"traducao-brasileira","editionId":"traducao-brasileira-1917","packageId":"pkg-traducao-brasileira-wikisource-1917","datasetId":"dataset:traducao-brasileira:1917:d5807b0ac0d4a24083ad099056acc1baf525306abd4c116046815641639243e6","sourceArtifactId":"artifact:wikisource:tbb:pages","sourcePath":"pages.json#pageid=119379&oldid=198286","bookId":"psalms","chapter":121,"verses":[{"ref":{"bookId":"psalms","chapter":121,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"traducao-brasileira-1917":"Elevo os meus olhos para os montes: Donde há de vir o meu socorro?"}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"traducao-brasileira-1917":"O meu socorro vem de Jeová, Que fez o céu e a terra."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"traducao-brasileira-1917":"Ele não permitirá que o teu pé vacile; Não dormitará aquele que te guarda."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"traducao-brasileira-1917":"Eis que não dormitará nem dormirá Aquele que guarda a Israel."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"traducao-brasileira-1917":"Jeová é quem te guarda; Jeová é a tua sombra à tua mão direita."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"traducao-brasileira-1917":"De dia não te ferirá o sol, Nem de noite a lua."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"traducao-brasileira-1917":"Jeová te guardará de todo o mal; Ele te guardará a alma."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"traducao-brasileira-1917":"Jeová guardará a tua saída e a tua entrada, Desde agora e para sempre."}}]}
