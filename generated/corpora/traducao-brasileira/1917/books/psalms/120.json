{"schemaVersion":2,"corpusId":"traducao-brasileira","editionId":"traducao-brasileira-1917","packageId":"pkg-traducao-brasileira-wikisource-1917","datasetId":"dataset:traducao-brasileira:1917:d5807b0ac0d4a24083ad099056acc1baf525306abd4c116046815641639243e6","sourceArtifactId":"artifact:wikisource:tbb:pages","sourcePath":"pages.json#pageid=119378&oldid=198285","bookId":"psalms","chapter":120,"verses":[{"ref":{"bookId":"psalms","chapter":120,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"traducao-brasileira-1917":"A Jeová, na minha tribulação, clamei, E ele me respondeu."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"traducao-brasileira-1917":"Livra, Jeová, de lábios mentirosos a minha alma, E da língua enganadora."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"traducao-brasileira-1917":"Que te será dado, e que te será acrescentado, Língua enganadora?"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"traducao-brasileira-1917":"Agudas setas do valente, Juntamente com carvões de giestas."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"traducao-brasileira-1917":"Ai de mim, que peregrino em Meseque, E habito entre as tendas de Quedar!"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"traducao-brasileira-1917":"Há muito que a minha alma habita Com aquele que odeia a paz."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"traducao-brasileira-1917":"Eu sou pela paz: Mas quando falo, eles são pela guerra. Salmos 120"}}]}
