{"schemaVersion":2,"corpusId":"traducao-brasileira","editionId":"traducao-brasileira-1917","packageId":"pkg-traducao-brasileira-wikisource-1917","datasetId":"dataset:traducao-brasileira:1917:d5807b0ac0d4a24083ad099056acc1baf525306abd4c116046815641639243e6","sourceArtifactId":"artifact:wikisource:tbb:pages","sourcePath":"pages.json#pageid=119372&oldid=198279","bookId":"psalms","chapter":114,"verses":[{"ref":{"bookId":"psalms","chapter":114,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"traducao-brasileira-1917":"Quando Israel saiu do Egito, A casa de Jacó, dentre povo de língua estranha;"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"traducao-brasileira-1917":"Judá tornou-se-lhe o santuário, Israel, o seu domínio."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"traducao-brasileira-1917":"O mar viu isto, e fugiu; O Jordão fugiu para trás."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"traducao-brasileira-1917":"Os montes saltaram como carneiros, As colinas como cordeiros do rebanho."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"traducao-brasileira-1917":"Que tens tu, ó mar, para fugires? E tu, ó Jordão, para recuares?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"traducao-brasileira-1917":"Vós, montes, que saltais como carneiros; Vós, colinas, como cordeiros do rebanho?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"traducao-brasileira-1917":"Treme, terra, na presença do Senhor, Na presença do Deus de Jacó,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"traducao-brasileira-1917":"O qual converteu a rocha em lago de água, O seixo em fonte de água. Salmos 114"}}]}
