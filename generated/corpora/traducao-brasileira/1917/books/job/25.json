{"schemaVersion":2,"corpusId":"traducao-brasileira","editionId":"traducao-brasileira-1917","packageId":"pkg-traducao-brasileira-wikisource-1917","datasetId":"dataset:traducao-brasileira:1917:d5807b0ac0d4a24083ad099056acc1baf525306abd4c116046815641639243e6","sourceArtifactId":"artifact:wikisource:tbb:pages","sourcePath":"pages.json#pageid=120742&oldid=197947","bookId":"job","chapter":25,"verses":[{"ref":{"bookId":"job","chapter":25,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"traducao-brasileira-1917":"Então respondeu Bildade suíta:"}},{"ref":{"bookId":"job","chapter":25,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"traducao-brasileira-1917":"A Deus pertence o domínio e o poder, Ele faz reinar a paz nas regiões celestes."}},{"ref":{"bookId":"job","chapter":25,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"traducao-brasileira-1917":"Acaso têm número as suas tropas? E sobre quem não surge a sua luz?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"traducao-brasileira-1917":"Como, pois, pode o homem ser justo diante de Deus? Ou como pode ser puro aquele que nasce de mulher?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"traducao-brasileira-1917":"Eis que até a lua não tem brilho, E as estrelas não são puras aos olhos dele;"}},{"ref":{"bookId":"job","chapter":25,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"traducao-brasileira-1917":"Quanto menos o que é verme! É o filho do homem que é vermezinho! Jo 25"}}]}
