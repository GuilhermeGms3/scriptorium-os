{"schemaVersion":2,"corpusId":"vulgata-clementina","editionId":"vulgata-clementina-2026-10-27","packageId":"pkg-ebible-vulgate-2026-10-27","datasetId":"dataset:vulgata-clementina:2026-10-27:439d1789e021e3209125270dd2e3476f9ff7e99fea2a0349778655e4e40b7826","sourceArtifactId":"artifact:ebible:latVUC:usfm:2026-10-27","sourcePath":"20-PSAlatVUC.usfm#chapter=81","bookId":"psalms","chapter":81,"verses":[{"ref":{"bookId":"psalms","chapter":81,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"vulgata-clementina-2026-10-27":"Psalmus Asaph. [Deus stetit in synagoga deorum; in medio autem deos dijudicat."}},{"ref":{"bookId":"psalms","chapter":81,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"vulgata-clementina-2026-10-27":"Usquequo judicatis iniquitatem, et facies peccatorum sumitis?"}},{"ref":{"bookId":"psalms","chapter":81,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"vulgata-clementina-2026-10-27":"Judicate egeno et pupillo; humilem et pauperem justificate."}},{"ref":{"bookId":"psalms","chapter":81,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"vulgata-clementina-2026-10-27":"Eripite pauperem, et egenum de manu peccatoris liberate."}},{"ref":{"bookId":"psalms","chapter":81,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"vulgata-clementina-2026-10-27":"Nescierunt, neque intellexerunt; in tenebris ambulant: movebuntur omnia fundamenta terræ."}},{"ref":{"bookId":"psalms","chapter":81,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"vulgata-clementina-2026-10-27":"Ego dixi: Dii estis, et filii Excelsi omnes."}},{"ref":{"bookId":"psalms","chapter":81,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"vulgata-clementina-2026-10-27":"Vos autem sicut homines moriemini, et sicut unus de principibus cadetis."}},{"ref":{"bookId":"psalms","chapter":81,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"vulgata-clementina-2026-10-27":"Surge, Deus, judica terram, quoniam tu hæreditabis in omnibus gentibus.]"}}]}
