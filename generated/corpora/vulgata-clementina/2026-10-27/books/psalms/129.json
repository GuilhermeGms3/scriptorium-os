{"schemaVersion":2,"corpusId":"vulgata-clementina","editionId":"vulgata-clementina-2026-10-27","packageId":"pkg-ebible-vulgate-2026-10-27","datasetId":"dataset:vulgata-clementina:2026-10-27:439d1789e021e3209125270dd2e3476f9ff7e99fea2a0349778655e4e40b7826","sourceArtifactId":"artifact:ebible:latVUC:usfm:2026-10-27","sourcePath":"20-PSAlatVUC.usfm#chapter=129","bookId":"psalms","chapter":129,"verses":[{"ref":{"bookId":"psalms","chapter":129,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"vulgata-clementina-2026-10-27":"Canticum graduum. [De profundis clamavi ad te, Domine;"}},{"ref":{"bookId":"psalms","chapter":129,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"vulgata-clementina-2026-10-27":"Domine, exaudi vocem meam. Fiant aures tuæ intendentes in vocem deprecationis meæ."}},{"ref":{"bookId":"psalms","chapter":129,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"vulgata-clementina-2026-10-27":"Si iniquitates observaveris, Domine, Domine, quis sustinebit?"}},{"ref":{"bookId":"psalms","chapter":129,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"vulgata-clementina-2026-10-27":"Quia apud te propitiatio est; et propter legem tuam sustinui te, Domine. Sustinuit anima mea in verbo ejus:"}},{"ref":{"bookId":"psalms","chapter":129,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"vulgata-clementina-2026-10-27":"speravit anima mea in Domino."}},{"ref":{"bookId":"psalms","chapter":129,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"vulgata-clementina-2026-10-27":"A custodia matutina usque ad noctem, speret Israël in Domino."}},{"ref":{"bookId":"psalms","chapter":129,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"vulgata-clementina-2026-10-27":"Quia apud Dominum misericordia, et copiosa apud eum redemptio."}},{"ref":{"bookId":"psalms","chapter":129,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"vulgata-clementina-2026-10-27":"Et ipse redimet Israël ex omnibus iniquitatibus ejus.]"}}]}
