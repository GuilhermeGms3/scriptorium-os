{"schemaVersion":2,"corpusId":"vulgata-clementina","editionId":"vulgata-clementina-2026-10-27","packageId":"pkg-ebible-vulgate-2026-10-27","datasetId":"dataset:vulgata-clementina:2026-10-27:439d1789e021e3209125270dd2e3476f9ff7e99fea2a0349778655e4e40b7826","sourceArtifactId":"artifact:ebible:latVUC:usfm:2026-10-27","sourcePath":"20-PSAlatVUC.usfm#chapter=119","bookId":"psalms","chapter":119,"verses":[{"ref":{"bookId":"psalms","chapter":119,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"vulgata-clementina-2026-10-27":"Canticum graduum. [Ad Dominum cum tribularer clamavi, et exaudivit me."}},{"ref":{"bookId":"psalms","chapter":119,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"vulgata-clementina-2026-10-27":"Domine, libera animam meam a labiis iniquis et a lingua dolosa."}},{"ref":{"bookId":"psalms","chapter":119,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"vulgata-clementina-2026-10-27":"Quid detur tibi, aut quid apponatur tibi ad linguam dolosam?"}},{"ref":{"bookId":"psalms","chapter":119,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"vulgata-clementina-2026-10-27":"Sagittæ potentis acutæ, cum carbonibus desolatoriis."}},{"ref":{"bookId":"psalms","chapter":119,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"vulgata-clementina-2026-10-27":"Heu mihi, quia incolatus meus prolongatus est! habitavi cum habitantibus Cedar;"}},{"ref":{"bookId":"psalms","chapter":119,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"vulgata-clementina-2026-10-27":"multum incola fuit anima mea."}},{"ref":{"bookId":"psalms","chapter":119,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"vulgata-clementina-2026-10-27":"Cum his qui oderunt pacem eram pacificus; cum loquebar illis, impugnabant me gratis.]"}}]}
