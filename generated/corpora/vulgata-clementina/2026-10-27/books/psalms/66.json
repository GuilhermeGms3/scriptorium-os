{"schemaVersion":2,"corpusId":"vulgata-clementina","editionId":"vulgata-clementina-2026-10-27","packageId":"pkg-ebible-vulgate-2026-10-27","datasetId":"dataset:vulgata-clementina:2026-10-27:439d1789e021e3209125270dd2e3476f9ff7e99fea2a0349778655e4e40b7826","sourceArtifactId":"artifact:ebible:latVUC:usfm:2026-10-27","sourcePath":"20-PSAlatVUC.usfm#chapter=66","bookId":"psalms","chapter":66,"verses":[{"ref":{"bookId":"psalms","chapter":66,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"vulgata-clementina-2026-10-27":"In finem, in hymnis. Psalmus cantici David."}},{"ref":{"bookId":"psalms","chapter":66,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"vulgata-clementina-2026-10-27":"[Deus misereatur nostri, et benedicat nobis; illuminet vultum suum super nos, et misereatur nostri:"}},{"ref":{"bookId":"psalms","chapter":66,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"vulgata-clementina-2026-10-27":"ut cognoscamus in terra viam tuam, in omnibus gentibus salutare tuum."}},{"ref":{"bookId":"psalms","chapter":66,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"vulgata-clementina-2026-10-27":"Confiteantur tibi populi, Deus: confiteantur tibi populi omnes."}},{"ref":{"bookId":"psalms","chapter":66,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"vulgata-clementina-2026-10-27":"Lætentur et exsultent gentes, quoniam judicas populos in æquitate, et gentes in terra dirigis."}},{"ref":{"bookId":"psalms","chapter":66,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"vulgata-clementina-2026-10-27":"Confiteantur tibi populi, Deus: confiteantur tibi populi omnes."}},{"ref":{"bookId":"psalms","chapter":66,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"vulgata-clementina-2026-10-27":"Terra dedit fructum suum: benedicat nos Deus, Deus noster!"}},{"ref":{"bookId":"psalms","chapter":66,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"vulgata-clementina-2026-10-27":"Benedicat nos Deus, et metuant eum omnes fines terræ.]"}}]}
