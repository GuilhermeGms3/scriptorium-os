{"schemaVersion":2,"corpusId":"vulgata-clementina","editionId":"vulgata-clementina-2026-10-27","packageId":"pkg-ebible-vulgate-2026-10-27","datasetId":"dataset:vulgata-clementina:2026-10-27:439d1789e021e3209125270dd2e3476f9ff7e99fea2a0349778655e4e40b7826","sourceArtifactId":"artifact:ebible:latVUC:usfm:2026-10-27","sourcePath":"20-PSAlatVUC.usfm#chapter=127","bookId":"psalms","chapter":127,"verses":[{"ref":{"bookId":"psalms","chapter":127,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"vulgata-clementina-2026-10-27":"Canticum graduum. [Beati omnes qui timent Dominum, qui ambulant in viis ejus."}},{"ref":{"bookId":"psalms","chapter":127,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"vulgata-clementina-2026-10-27":"Labores manuum tuarum quia manducabis: beatus es, et bene tibi erit."}},{"ref":{"bookId":"psalms","chapter":127,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"vulgata-clementina-2026-10-27":"Uxor tua sicut vitis abundans in lateribus domus tuæ; filii tui sicut novellæ olivarum in circuitu mensæ tuæ."}},{"ref":{"bookId":"psalms","chapter":127,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"vulgata-clementina-2026-10-27":"Ecce sic benedicetur homo qui timet Dominum."}},{"ref":{"bookId":"psalms","chapter":127,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"vulgata-clementina-2026-10-27":"Benedicat tibi Dominus ex Sion, et videas bona Jerusalem omnibus diebus vitæ tuæ."}},{"ref":{"bookId":"psalms","chapter":127,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"vulgata-clementina-2026-10-27":"Et videas filios filiorum tuorum: pacem super Israël.]"}}]}
