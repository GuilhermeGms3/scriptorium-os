{"schemaVersion":2,"corpusId":"vulgata-clementina","editionId":"vulgata-clementina-2026-10-27","packageId":"pkg-ebible-vulgate-2026-10-27","datasetId":"dataset:vulgata-clementina:2026-10-27:439d1789e021e3209125270dd2e3476f9ff7e99fea2a0349778655e4e40b7826","sourceArtifactId":"artifact:ebible:latVUC:usfm:2026-10-27","sourcePath":"20-PSAlatVUC.usfm#chapter=121","bookId":"psalms","chapter":121,"verses":[{"ref":{"bookId":"psalms","chapter":121,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"vulgata-clementina-2026-10-27":"Canticum graduum. [Lætatus sum in his quæ dicta sunt mihi: In domum Domini ibimus."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"vulgata-clementina-2026-10-27":"Stantes erant pedes nostri in atriis tuis, Jerusalem."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"vulgata-clementina-2026-10-27":"Jerusalem, quæ ædificatur ut civitas, cujus participatio ejus in idipsum."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"vulgata-clementina-2026-10-27":"Illuc enim ascenderunt tribus, tribus Domini: testimonium Israël, ad confitendum nomini Domini."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"vulgata-clementina-2026-10-27":"Quia illic sederunt sedes in judicio, sedes super domum David."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"vulgata-clementina-2026-10-27":"Rogate quæ ad pacem sunt Jerusalem, et abundantia diligentibus te."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"vulgata-clementina-2026-10-27":"Fiat pax in virtute tua, et abundantia in turribus tuis."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"vulgata-clementina-2026-10-27":"Propter fratres meos et proximos meos, loquebar pacem de te."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"vulgata-clementina-2026-10-27":"Propter domum Domini Dei nostri, quæsivi bona tibi.]"}}]}
