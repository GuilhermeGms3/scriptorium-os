{"schemaVersion":2,"corpusId":"reina-valera-1909","editionId":"reina-valera-1909-2026-10-27","packageId":"pkg-ebible-rv1909-2026-10-27","datasetId":"dataset:reina-valera-1909:2026-10-27:b8c5f45ef19a6d26faa0844dedbb2c8aceefd8698f5ed1e070878f41715b1869","sourceArtifactId":"artifact:ebible:spaRV1909:usfm:2026-10-27","sourcePath":"20-PSAspaRV1909.usfm#chapter=130","bookId":"psalms","chapter":130,"verses":[{"ref":{"bookId":"psalms","chapter":130,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"reina-valera-1909-2026-10-27":"Cántico gradual. DE los profundos, oh Jehová, á ti clamo."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"reina-valera-1909-2026-10-27":"Señor, oye mi voz; estén atentos tus oídos á la voz de mi súplica."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"reina-valera-1909-2026-10-27":"JAH, si mirares á los pecados, ¿ quién, oh Señor, podrá mantenerse?"}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"reina-valera-1909-2026-10-27":"Empero hay perdón cerca de ti, para que seas temido."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"reina-valera-1909-2026-10-27":"Esperé yo á Jehová, esperó mi alma; en su palabra he esperado."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"reina-valera-1909-2026-10-27":"Mi alma espera á Jehová más que los centinelas á la mañana, más que los vigilantes á la mañana."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"reina-valera-1909-2026-10-27":"Espere Israel á Jehová; porque en Jehová hay misericordia, y abundante redención con él."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"reina-valera-1909-2026-10-27":"Y él redimirá á Israel de todos sus pecados."}}]}
