{"schemaVersion":2,"corpusId":"reina-valera-1909","editionId":"reina-valera-1909-2026-10-27","packageId":"pkg-ebible-rv1909-2026-10-27","datasetId":"dataset:reina-valera-1909:2026-10-27:b8c5f45ef19a6d26faa0844dedbb2c8aceefd8698f5ed1e070878f41715b1869","sourceArtifactId":"artifact:ebible:spaRV1909:usfm:2026-10-27","sourcePath":"20-PSAspaRV1909.usfm#chapter=113","bookId":"psalms","chapter":113,"verses":[{"ref":{"bookId":"psalms","chapter":113,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"reina-valera-1909-2026-10-27":"Aleluya. ALABAD, siervos de Jehová, alabad el nombre de Jehová."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"reina-valera-1909-2026-10-27":"Sea el nombre de Jehová bendito, desde ahora y para siempre."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"reina-valera-1909-2026-10-27":"Desde el nacimiento del sol hasta donde se pone, sea alabado el nombre de Jehová."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"reina-valera-1909-2026-10-27":"Alto sobre todas las naciones es Jehová; sobre los cielos su gloria."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"reina-valera-1909-2026-10-27":"¿ Quién como Jehová nuestro Dios, que ha enaltecido su habitación,"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"reina-valera-1909-2026-10-27":"Que se humilla á mirar en el cielo y en la tierra?"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"reina-valera-1909-2026-10-27":"El levanta del polvo al pobre, y al menesteroso alza del estiércol,"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"reina-valera-1909-2026-10-27":"Para hacerlos sentar con los príncipes, con los príncipes de su pueblo."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"reina-valera-1909-2026-10-27":"El hace habitar en familia á la estéril, gozosa en ser madre de hijos. Aleluya."}}]}
