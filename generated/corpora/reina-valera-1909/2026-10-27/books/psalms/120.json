{"schemaVersion":2,"corpusId":"reina-valera-1909","editionId":"reina-valera-1909-2026-10-27","packageId":"pkg-ebible-rv1909-2026-10-27","datasetId":"dataset:reina-valera-1909:2026-10-27:b8c5f45ef19a6d26faa0844dedbb2c8aceefd8698f5ed1e070878f41715b1869","sourceArtifactId":"artifact:ebible:spaRV1909:usfm:2026-10-27","sourcePath":"20-PSAspaRV1909.usfm#chapter=120","bookId":"psalms","chapter":120,"verses":[{"ref":{"bookId":"psalms","chapter":120,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"reina-valera-1909-2026-10-27":"Cántico gradual. A JEHOVÁ llamé estando en angustia, y él me respondió."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"reina-valera-1909-2026-10-27":"Libra mi alma, oh Jehová, de labio mentiroso, de la lengua fraudulenta."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"reina-valera-1909-2026-10-27":"¿ Qué te dará, ó qué te aprovechará, oh lengua engañosa?"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"reina-valera-1909-2026-10-27":"Agudas saetas de valiente, con brasas de enebro."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"reina-valera-1909-2026-10-27":"¡ Ay de mí, que peregrino en Mesech, y habito entre las tiendas de Kedar!"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"reina-valera-1909-2026-10-27":"Mucho se detiene mi alma con los que aborrecen la paz."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"reina-valera-1909-2026-10-27":"Yo soy pacífico: mas ellos, así que hablo, me hacen guerra."}}]}
