{"schemaVersion":2,"corpusId":"reina-valera-1909","editionId":"reina-valera-1909-2026-10-27","packageId":"pkg-ebible-rv1909-2026-10-27","datasetId":"dataset:reina-valera-1909:2026-10-27:b8c5f45ef19a6d26faa0844dedbb2c8aceefd8698f5ed1e070878f41715b1869","sourceArtifactId":"artifact:ebible:spaRV1909:usfm:2026-10-27","sourcePath":"20-PSAspaRV1909.usfm#chapter=121","bookId":"psalms","chapter":121,"verses":[{"ref":{"bookId":"psalms","chapter":121,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"reina-valera-1909-2026-10-27":"Cántico gradual. ALZARÉ mis ojos á los montes, de donde vendrá mi socorro."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"reina-valera-1909-2026-10-27":"Mi socorro viene de Jehová, que hizo los cielos y la tierra."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"reina-valera-1909-2026-10-27":"No dará tu pie al resbaladero; ni se dormirá el que te guarda."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"reina-valera-1909-2026-10-27":"He aquí, no se adormecerá ni dormirá el que guarda á Israel."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"reina-valera-1909-2026-10-27":"Jehová es tu guardador: Jehová es tu sombra á tu mano derecha."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"reina-valera-1909-2026-10-27":"El sol no te fatigará de día, ni la luna de noche."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"reina-valera-1909-2026-10-27":"Jehová te guardará de todo mal: él guardará tu alma."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"reina-valera-1909-2026-10-27":"Jehová guardará tu salida y tu entrada, desde ahora y para siempre."}}]}
