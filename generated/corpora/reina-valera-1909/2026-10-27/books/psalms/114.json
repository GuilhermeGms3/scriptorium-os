{"schemaVersion":2,"corpusId":"reina-valera-1909","editionId":"reina-valera-1909-2026-10-27","packageId":"pkg-ebible-rv1909-2026-10-27","datasetId":"dataset:reina-valera-1909:2026-10-27:b8c5f45ef19a6d26faa0844dedbb2c8aceefd8698f5ed1e070878f41715b1869","sourceArtifactId":"artifact:ebible:spaRV1909:usfm:2026-10-27","sourcePath":"20-PSAspaRV1909.usfm#chapter=114","bookId":"psalms","chapter":114,"verses":[{"ref":{"bookId":"psalms","chapter":114,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"reina-valera-1909-2026-10-27":"CUANDO salió Israel de Egipto, la casa de Jacob del pueblo bárbaro,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"reina-valera-1909-2026-10-27":"Judá fué su consagrada heredad, Israel su señorío."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"reina-valera-1909-2026-10-27":"La mar vió, y huyó; el Jordán se volvió atrás."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"reina-valera-1909-2026-10-27":"Los montes saltaron como carneros: los collados como corderitos."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"reina-valera-1909-2026-10-27":"¿ Qué tuviste, oh mar, que huiste? ¿y tú, oh Jordán, que te volviste atrás?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"reina-valera-1909-2026-10-27":"Oh montes, ¿ por qué saltasteis como carneros, y vosotros, collados, como corderitos?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"reina-valera-1909-2026-10-27":"A la presencia del Señor tiembla la tierra, á la presencia del Dios de Jacob;"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"reina-valera-1909-2026-10-27":"El cual tornó la peña en estanque de aguas, y en fuente de aguas la roca."}}]}
