{"schemaVersion":2,"corpusId":"reina-valera-1909","editionId":"reina-valera-1909-2026-10-27","packageId":"pkg-ebible-rv1909-2026-10-27","datasetId":"dataset:reina-valera-1909:2026-10-27:b8c5f45ef19a6d26faa0844dedbb2c8aceefd8698f5ed1e070878f41715b1869","sourceArtifactId":"artifact:ebible:spaRV1909:usfm:2026-10-27","sourcePath":"26-LAMspaRV1909.usfm#chapter=3","bookId":"lamentations","chapter":3,"verses":[{"ref":{"bookId":"lamentations","chapter":3,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"reina-valera-1909-2026-10-27":"YO soy el hombre que ha visto aflicción en la vara de su enojo."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"reina-valera-1909-2026-10-27":"Guióme y llevóme en tinieblas, mas no en luz."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"reina-valera-1909-2026-10-27":"Ciertamente contra mí volvió y revolvió su mano todo el día."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"reina-valera-1909-2026-10-27":"Hizo envejecer mi carne y mi piel; quebrantó mis huesos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"reina-valera-1909-2026-10-27":"Edificó contra mí, y cercóme de tósigo y de trabajo."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"reina-valera-1909-2026-10-27":"Asentóme en oscuridades, como los ya muertos de mucho tiempo."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"reina-valera-1909-2026-10-27":"Cercóme por todos lados, y no puedo salir; agravó mis grillos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"reina-valera-1909-2026-10-27":"Aun cuando clamé y dí voces, cerro los oídos á mi oración."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"reina-valera-1909-2026-10-27":"Cercó mis caminos con piedra tajada, torció mis senderos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":10,"verseEnd":10},"verse":10,"translations":{"reina-valera-1909-2026-10-27":"Como oso que acecha fué para mí, como león en escondrijos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":11,"verseEnd":11},"verse":11,"translations":{"reina-valera-1909-2026-10-27":"Torció mis caminos, y depedazóme; tornóme asolado."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":12,"verseEnd":12},"verse":12,"translations":{"reina-valera-1909-2026-10-27":"Su arco entesó, y púsome como blanco á la saeta."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":13,"verseEnd":13},"verse":13,"translations":{"reina-valera-1909-2026-10-27":"Hizo entrar en mis riñones las saetas de su aljaba."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":14,"verseEnd":14},"verse":14,"translations":{"reina-valera-1909-2026-10-27":"Fuí escarnio á todo mi pueblo, canción de ellos todos los días."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":15,"verseEnd":15},"verse":15,"translations":{"reina-valera-1909-2026-10-27":"Hartóme de amarguras, embriagóme de ajenjos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":16,"verseEnd":16},"verse":16,"translations":{"reina-valera-1909-2026-10-27":"Quebróme los dientes con cascajo, cubrióme de ceniza."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":17,"verseEnd":17},"verse":17,"translations":{"reina-valera-1909-2026-10-27":"Y mi alma se alejó de la paz, olvidéme del bien."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":18,"verseEnd":18},"verse":18,"translations":{"reina-valera-1909-2026-10-27":"Y dije: Pereció mi fortaleza, y mi esperanza de Jehová."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":19,"verseEnd":19},"verse":19,"translations":{"reina-valera-1909-2026-10-27":"Acuérdate de mi aflicción y de mi abatimiento, del ajenjo y de la hiel."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":20,"verseEnd":20},"verse":20,"translations":{"reina-valera-1909-2026-10-27":"Tendrálo aún en memoria mi alma, porque en mí está humillada."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":21,"verseEnd":21},"verse":21,"translations":{"reina-valera-1909-2026-10-27":"Esto reduciré á mi corazón, por lo cual esperaré."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":22,"verseEnd":22},"verse":22,"translations":{"reina-valera-1909-2026-10-27":"Es por la misericordia de Jehová que no somos consumidos, porque nunca decayeron sus misericordias."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":23,"verseEnd":23},"verse":23,"translations":{"reina-valera-1909-2026-10-27":"Nuevas son cada mañana; grande es tu fidelidad."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":24,"verseEnd":24},"verse":24,"translations":{"reina-valera-1909-2026-10-27":"Mi parte es Jehová, dijo mi alma; por tanto en él esperaré."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":25,"verseEnd":25},"verse":25,"translations":{"reina-valera-1909-2026-10-27":"Bueno es Jehová á los que en él esperan, al alma que le buscare."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":26,"verseEnd":26},"verse":26,"translations":{"reina-valera-1909-2026-10-27":"Bueno es esperar callando en la salud de Jehová."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":27,"verseEnd":27},"verse":27,"translations":{"reina-valera-1909-2026-10-27":"Bueno es al hombre, si llevare el yugo desde su mocedad."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":28,"verseEnd":28},"verse":28,"translations":{"reina-valera-1909-2026-10-27":"Sentaráse solo, y callará, porque lo llevó sobre sí."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":29,"verseEnd":29},"verse":29,"translations":{"reina-valera-1909-2026-10-27":"Pondrá su boca en el polvo, por si quizá hay esperanza."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":30,"verseEnd":30},"verse":30,"translations":{"reina-valera-1909-2026-10-27":"Dará la mejilla al que le hiriere; hartaráse de afrenta."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":31,"verseEnd":31},"verse":31,"translations":{"reina-valera-1909-2026-10-27":"Porque el Señor no desechará para siempre:"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":32,"verseEnd":32},"verse":32,"translations":{"reina-valera-1909-2026-10-27":"Antes si afligiere, también se compadecerá según la multitud de sus misericordias."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":33,"verseEnd":33},"verse":33,"translations":{"reina-valera-1909-2026-10-27":"Porque no aflige ni congoja de su corazón á los hijos de los hombres."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":34,"verseEnd":34},"verse":34,"translations":{"reina-valera-1909-2026-10-27":"Desmenuzar bajo de sus pies todos los encarcelados de la tierra,"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":35,"verseEnd":35},"verse":35,"translations":{"reina-valera-1909-2026-10-27":"Hacer apartar el derecho del hombre ante la presencia del Altísimo,"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":36,"verseEnd":36},"verse":36,"translations":{"reina-valera-1909-2026-10-27":"Trastornar al hombre en su causa, el Señor no lo sabe."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":37,"verseEnd":37},"verse":37,"translations":{"reina-valera-1909-2026-10-27":"¿ Quién será aquel que diga, que vino algo que el Señor no mandó?"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":38,"verseEnd":38},"verse":38,"translations":{"reina-valera-1909-2026-10-27":"¿ De la boca del Altísimo no saldrá malo y bueno?"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":39,"verseEnd":39},"verse":39,"translations":{"reina-valera-1909-2026-10-27":"¿ Por qué murmura el hombre viviente, el hombre en su pecado?"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":40,"verseEnd":40},"verse":40,"translations":{"reina-valera-1909-2026-10-27":"Escudriñemos nuestros caminos, y busquemos, y volvámonos á Jehová."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":41,"verseEnd":41},"verse":41,"translations":{"reina-valera-1909-2026-10-27":"Levantemos nuestros corazones con las manos á Dios en los cielos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":42,"verseEnd":42},"verse":42,"translations":{"reina-valera-1909-2026-10-27":"Nosotros nos hemos rebelado, y fuimos desleales; tú no perdonaste."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":43,"verseEnd":43},"verse":43,"translations":{"reina-valera-1909-2026-10-27":"Desplegaste la ira, y nos perseguiste; mataste, no perdonaste."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":44,"verseEnd":44},"verse":44,"translations":{"reina-valera-1909-2026-10-27":"Te cubriste de nube, porque no pasase la oración nuestra."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":45,"verseEnd":45},"verse":45,"translations":{"reina-valera-1909-2026-10-27":"Raedura y abominación nos tornaste en medio de los pueblos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":46,"verseEnd":46},"verse":46,"translations":{"reina-valera-1909-2026-10-27":"Todos nuestros enemigos abrieron sobre nosotros su boca."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":47,"verseEnd":47},"verse":47,"translations":{"reina-valera-1909-2026-10-27":"Temor y lazo fué para nosotros, asolamiento y quebrantamiento."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":48,"verseEnd":48},"verse":48,"translations":{"reina-valera-1909-2026-10-27":"Ríos de aguas echan mis ojos, por el quebrantamiento de la hija de mi pueblo."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":49,"verseEnd":49},"verse":49,"translations":{"reina-valera-1909-2026-10-27":"Mis ojos destilan, y no cesan, porque no hay alivio,"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":50,"verseEnd":50},"verse":50,"translations":{"reina-valera-1909-2026-10-27":"Hasta que Jehová mire y vea desde los cielos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":51,"verseEnd":51},"verse":51,"translations":{"reina-valera-1909-2026-10-27":"Mis ojos contristaron mi alma, por todas las hijas de mi ciudad."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":52,"verseEnd":52},"verse":52,"translations":{"reina-valera-1909-2026-10-27":"Mis enemigos me dieron caza como á ave, sin por qué."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":53,"verseEnd":53},"verse":53,"translations":{"reina-valera-1909-2026-10-27":"Ataron mi vida en mazmorra, pusieron piedra sobre mí."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":54,"verseEnd":54},"verse":54,"translations":{"reina-valera-1909-2026-10-27":"Aguas de avenida vinieron sobre mi cabeza; yo dije: Muerto soy."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":55,"verseEnd":55},"verse":55,"translations":{"reina-valera-1909-2026-10-27":"Invoqué tu nombre, oh Jehová, desde la cárcel profunda."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":56,"verseEnd":56},"verse":56,"translations":{"reina-valera-1909-2026-10-27":"Oiste mi voz; no escondas tu oído á mi clamor, para mi respiro."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":57,"verseEnd":57},"verse":57,"translations":{"reina-valera-1909-2026-10-27":"Acercástete el día que te invoqué: dijiste: No temas."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":58,"verseEnd":58},"verse":58,"translations":{"reina-valera-1909-2026-10-27":"Abogaste, Señor, la causa de mi alma; redimiste mi vida."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":59,"verseEnd":59},"verse":59,"translations":{"reina-valera-1909-2026-10-27":"Tú has visto, oh Jehová, mi agravio; defiende mi causa."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":60,"verseEnd":60},"verse":60,"translations":{"reina-valera-1909-2026-10-27":"Tú has visto toda su venganza; todos sus pensamientos contra mí."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":61,"verseEnd":61},"verse":61,"translations":{"reina-valera-1909-2026-10-27":"Tú has oído el oprobio de ellos, oh Jehová, todas sus maquinaciones contra mí;"}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":62,"verseEnd":62},"verse":62,"translations":{"reina-valera-1909-2026-10-27":"Los dichos de los que contra mí se levantaron, y su designio contra mí todo el día."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":63,"verseEnd":63},"verse":63,"translations":{"reina-valera-1909-2026-10-27":"Su sentarse, y su levantarse mira: yo soy su canción."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":64,"verseEnd":64},"verse":64,"translations":{"reina-valera-1909-2026-10-27":"Dales el pago, oh Jehová, según la obra de sus manos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":65,"verseEnd":65},"verse":65,"translations":{"reina-valera-1909-2026-10-27":"Dales ansia de corazón, tu maldición á ellos."}},{"ref":{"bookId":"lamentations","chapter":3,"verseStart":66,"verseEnd":66},"verse":66,"translations":{"reina-valera-1909-2026-10-27":"Persíguelos en tu furor, y quebrántalos de debajo de los cielos, oh Jehová."}}]}
