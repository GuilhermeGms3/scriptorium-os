{"schemaVersion":2,"corpusId":"biblia-livre","editionId":"biblia-livre-n4-2025.1.0","packageId":"biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3","datasetId":"dataset:biblia-livre:2025.1.0:8ec95eabb3a03f017cec34eeb6571dab09893478027c5b46b1774fa5c7c6b94e","sourceArtifactId":"artifact:biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3:sal","sourcePath":"textos/f4/n4/sal.txt","bookId":"psalms","chapter":113,"verses":[{"ref":{"bookId":"psalms","chapter":113,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-livre-n4-2025.1.0":"Aleluia! Louvai, servos do SENHOR, louvai o nome do SENHOR."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-livre-n4-2025.1.0":"Seja bendito o nome do SENHOR, desde agora e para sempre."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-livre-n4-2025.1.0":"Desde o nascer do sol até o poente, seja louvado o nome do SENHOR."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-livre-n4-2025.1.0":"O SENHOR está elevado acima de todas as nações, e sua glória acima dos céus."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-livre-n4-2025.1.0":"Quem é como o SENHOR nosso Deus, que habita nas alturas,"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-livre-n4-2025.1.0":"que se inclina para baixo para ver o que há nos céus e na terra?"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-livre-n4-2025.1.0":"Ele levanta o pobre do pó, e do lixo ergue o necessitado,"}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-livre-n4-2025.1.0":"para fazê-lo assentar com os príncipes, com os príncipes de seu povo."}},{"ref":{"bookId":"psalms","chapter":113,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"biblia-livre-n4-2025.1.0":"Ele faz a mulher estéril habitar em família, e seja alegre mãe de filhos. Aleluia!"}}]}
