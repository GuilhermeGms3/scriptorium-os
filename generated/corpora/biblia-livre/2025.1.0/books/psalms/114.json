{"schemaVersion":2,"corpusId":"biblia-livre","editionId":"biblia-livre-n4-2025.1.0","packageId":"biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3","datasetId":"dataset:biblia-livre:2025.1.0:8ec95eabb3a03f017cec34eeb6571dab09893478027c5b46b1774fa5c7c6b94e","sourceArtifactId":"artifact:biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3:sal","sourcePath":"textos/f4/n4/sal.txt","bookId":"psalms","chapter":114,"verses":[{"ref":{"bookId":"psalms","chapter":114,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-livre-n4-2025.1.0":"Quando Israel saiu do Egito, e a casa de Jacó, de um povo estrangeiro,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-livre-n4-2025.1.0":"Judá se tornou seu santuário, e Israel o seu domínio."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-livre-n4-2025.1.0":"O mar viu isso, e fugiu; e o Jordão voltou atrás."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-livre-n4-2025.1.0":"Os montes saltaram como carneiros, as colinas como cordeiros."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-livre-n4-2025.1.0":"Que houve contigo, ó mar, que fugiste? E tu, Jordão, que voltaste atrás?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-livre-n4-2025.1.0":"E vós montes, que saltastes como carneiros? E as colinas, como cordeiros?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-livre-n4-2025.1.0":"Treme, ó terra, na presença do Senhor, na presença do Deus de Jacó,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-livre-n4-2025.1.0":"que tornou o rochedo em lagoa de água, e a pedra em fonte de águas."}}]}
