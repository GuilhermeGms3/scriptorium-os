{"schemaVersion":2,"corpusId":"biblia-livre","editionId":"biblia-livre-n4-2025.1.0","packageId":"biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3","datasetId":"dataset:biblia-livre:2025.1.0:8ec95eabb3a03f017cec34eeb6571dab09893478027c5b46b1774fa5c7c6b94e","sourceArtifactId":"artifact:biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3:sal","sourcePath":"textos/f4/n4/sal.txt","bookId":"psalms","chapter":122,"verses":[{"ref":{"bookId":"psalms","chapter":122,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-livre-n4-2025.1.0":"Alegrei-me quando me disseram: “Vamos à casa do SENHOR”."}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-livre-n4-2025.1.0":"Nossos pés estão dentro de tuas portas, ó Jerusalém."}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-livre-n4-2025.1.0":"Jerusalém está construída como uma cidade bem unida;"}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-livre-n4-2025.1.0":"para onde as tribos sobem, as tribos do SENHOR, conforme a ordenança de Israel, para darem graças ao nome do SENHOR."}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-livre-n4-2025.1.0":"Pois ali estão as tronos do julgamento, os tronos da casa de Davi."}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-livre-n4-2025.1.0":"Orem pela paz de Jerusalém; prosperem aqueles que te amam."}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"biblia-livre-n4-2025.1.0":"Haja paz em teus muros, e prosperidade em teus palácios."}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"biblia-livre-n4-2025.1.0":"Por causa dos meus irmãos e amigos, assim direi: Haja paz em ti."}},{"ref":{"bookId":"psalms","chapter":122,"verseStart":9,"verseEnd":9},"verse":9,"translations":{"biblia-livre-n4-2025.1.0":"Por amor à casa do SENHOR, nosso Deus, buscarei o teu bem."}}]}
