{"schemaVersion":2,"corpusId":"biblia-livre","editionId":"biblia-livre-n4-2025.1.0","packageId":"biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3","datasetId":"dataset:biblia-livre:2025.1.0:8ec95eabb3a03f017cec34eeb6571dab09893478027c5b46b1774fa5c7c6b94e","sourceArtifactId":"artifact:biblia-livre-official-a315a15e9f4d01883b62206fe441d57762f126b3:jo","sourcePath":"textos/f4/n4/jo.txt","bookId":"job","chapter":25,"verses":[{"ref":{"bookId":"job","chapter":25,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"biblia-livre-n4-2025.1.0":"Então Bildade, o suíta, respondeu, dizendo:"}},{"ref":{"bookId":"job","chapter":25,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"biblia-livre-n4-2025.1.0":"O domínio e o temor estão com ele; ele faz paz em suas alturas."}},{"ref":{"bookId":"job","chapter":25,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"biblia-livre-n4-2025.1.0":"Por acaso suas tropas têm número? E sobre quem não se levanta sua luz?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"biblia-livre-n4-2025.1.0":"Como, pois, o ser humano seria justo para com Deus? E como seria puro aquele que nasce de mulher?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"biblia-livre-n4-2025.1.0":"Eis que até a luz não tem brilho; nem as estrelas são puras diante de seus olhos."}},{"ref":{"bookId":"job","chapter":25,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"biblia-livre-n4-2025.1.0":"Quanto menos o ser humano, que é uma larva, e o filho de homem, que é um verme."}}]}
