},"verse":35,"translations":{"nova-biblia-viva-2026-10-27":"de Senaá, 3.630."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":36,"verseEnd":36},"verse":36,"translations":{"nova-biblia-viva-2026-10-27":"Esta é a lista dos grupos de famílias dos sacerdotes que voltaram do cativeiro: dos descendentes de Jedaías, por meio da família de Jesua, 973;"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":37,"verseEnd":37},"verse":37,"translations":{"nova-biblia-viva-2026-10-27":"da família de Imer, 1.052;"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":38,"verseEnd":38},"verse":38,"translations":{"nova-biblia-viva-2026-10-27":"da família de Pasur, 1.247;"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":39,"verseEnd":39},"verse":39,"translations":{"nova-biblia-viva-2026-10-27":"da família de Harim, 1.017."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":40,"verseEnd":40},"verse":40,"translations":{"nova-biblia-viva-2026-10-27":"Esta é a lista dos grupos de famílias dos levitas que voltaram do cativeiro: das famílias de Jesua e Cadmiel, por meio dos descendentes de Hodavias, 74."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":41,"verseEnd":41},"verse":41,"translations":{"nova-biblia-viva-2026-10-27":"Os cantores: descendentes da família de Asafe, 128."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":42,"verseEnd":42},"verse":42,"translations":{"nova-biblia-viva-2026-10-27":"Dos porteiros do templo: das famílias de Salum, Ater, Talmom, Acube, Hatita e Sobai, 139."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":43,"verseEnd":43},"verse":43,"translations":{"nova-biblia-viva-2026-10-27":"Esta é a lista dos grupos de famílias de servidores do templo que voltaram do cativeiro: Zia, Hasufa, Tabaote,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":44,"verseEnd":44},"verse":44,"translations":{"nova-biblia-viva-2026-10-27":"Queros, Sia, Padom,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":45,"verseEnd":45},"verse":45,"translations":{"nova-biblia-viva-2026-10-27":"Lebaná, Hagaba, Acube,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":46,"verseEnd":46},"verse":46,"translations":{"nova-biblia-viva-2026-10-27":"Hagabe, Sanlai, Hanã,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":47,"verseEnd":47},"verse":47,"translations":{"nova-biblia-viva-2026-10-27":"Gidel, Gaar, Reaías,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":48,"verseEnd":48},"verse":48,"translations":{"nova-biblia-viva-2026-10-27":"Rezim, Necoda, Gazão,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":49,"verseEnd":49},"verse":49,"translations":{"nova-biblia-viva-2026-10-27":"Uzá, Paseá, Besai,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":50,"verseEnd":50},"verse":50,"translations":{"nova-biblia-viva-2026-10-27":"Asná, Meunim, Nefusim,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":51,"verseEnd":51},"verse":51,"translations":{"nova-biblia-viva-2026-10-27":"Baquebuque, Hacufa, Harur,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":52,"verseEnd":52},"verse":52,"translations":{"nova-biblia-viva-2026-10-27":"Baslute, Meída, Harsa,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":53,"verseEnd":53},"verse":53,"translations":{"nova-biblia-viva-2026-10-27":"Barcos, Sísera, Temá,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":54,"verseEnd":54},"verse":54,"translations":{"nova-biblia-viva-2026-10-27":"Neziá, Hatifa."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":55,"verseEnd":55},"verse":55,"translations":{"nova-biblia-viva-2026-10-27":"Esta é a lista dos grupos de famílias dos servidores de Salomão que voltaram do cativeiro: os descendentes de Sotai, Soferete, Peruda,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":56,"verseEnd":56},"verse":56,"translations":{"nova-biblia-viva-2026-10-27":"Jaala, Darcom, Gidel,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":57,"verseEnd":57},"verse":57,"translations":{"nova-biblia-viva-2026-10-27":"Sefatias, Hatil, Poquerete-Hazebaim e Ami."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":58,"verseEnd":58},"verse":58,"translations":{"nova-biblia-viva-2026-10-27":"Os servidores do templo e os descendentes dos oficiais de Salomão eram 392."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":59,"verseEnd":59},"verse":59,"translations":{"nova-biblia-viva-2026-10-27":"Nessa ocasião também voltou para Jerusalém outro grupo vindo das cidades persas de Tel-Melá, Tel-Harsa, Querube, Adã e Imer. Mas, pelo fato de haverem perdido seus registros de família, não puderam provar que realmente eram descendentes de Israel."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":60,"verseEnd":60},"verse":60,"translations":{"nova-biblia-viva-2026-10-27":"Esse grupo incluía os grupos de famílias de Delaías, de Tobias e de Necoda, num total de 652."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":61,"verseEnd":61},"verse":61,"translations":{"nova-biblia-viva-2026-10-27":"O grupo de famílias de sacerdotes — Habaías, Hacoz e Barzilai, que se casou com uma das filhas de Barzilai, de Gileade, e ficou com o nome do sogro dele."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":62,"verseEnd":62},"verse":62,"translations":{"nova-biblia-viva-2026-10-27":"Mas eles também haviam perdido seus registros de família, por isso não foram aceitos como sacerdotes."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":63,"verseEnd":63},"verse":63,"translations":{"nova-biblia-viva-2026-10-27":"O governador proibiu-os de comer alimentos sagrados até que aparecesse um sacerdote que pudesse consultar o Urim e Tumim e saber de Deus se realmente eram ou não descendentes de sacerdotes."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":64,"verseEnd":64},"verse":64,"translations":{"nova-biblia-viva-2026-10-27":"Assim, os que voltaram para Judá eram um total de 42.360 homens,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":65,"verseEnd":65},"verse":65,"translations":{"nova-biblia-viva-2026-10-27":"isso sem contar os 7.337 escravos e escravas e 200 cantores e cantoras."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":66,"verseEnd":66},"verse":66,"translations":{"nova-biblia-viva-2026-10-27":"Eles levaram consigo 736 cavalos, 245 mulos,"}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":67,"verseEnd":67},"verse":67,"translations":{"nova-biblia-viva-2026-10-27":"435 camelos e 6.720 jumentos."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":68,"verseEnd":68},"verse":68,"translations":{"nova-biblia-viva-2026-10-27":"Quando chegaram ao templo do Senhor em Jerusalém, alguns dos chefes dos grupos de famílias puderam contribuir generosamente para a reconstrução do templo do Senhor no seu antigo local."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":69,"verseEnd":69},"verse":69,"translations":{"nova-biblia-viva-2026-10-27":"Cada um contribuiu de acordo com as suas possibilidades. O valor total das suas contribuições foi de quinhentos quilos de ouro, três toneladas de prata, e cem vestes sacerdotais."}},{"ref":{"bookId":"ezra","chapter":2,"verseStart":70,"verseEnd":70},"verse":70,"translations":{"nova-biblia-viva-2026-10-27":"Desse modo os sacerdotes, os levitas e alguns do povo se estabeleceram em Jerusalém e nas vilas vizinhas; os cantores, os porteiros, os servidores do templo e o restante do povo voltaram para as suas cidades de Judá, de onde haviam saído."}}]}
