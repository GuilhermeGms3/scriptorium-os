{"schemaVersion":2,"corpusId":"world-english-bible","editionId":"world-english-bible-2026-10-27","packageId":"pkg-ebible-web-2026-10-27","datasetId":"dataset:world-english-bible:2026-10-27:d2a7c9640820003d8ed475ce6d92cc990b0447fe96ce72fd0df17c0dac9d95fe","sourceArtifactId":"artifact:ebible:engwebp:usfm:2026-10-27","sourcePath":"19-JOBengwebp.usfm#chapter=25","bookId":"job","chapter":25,"verses":[{"ref":{"bookId":"job","chapter":25,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"world-english-bible-2026-10-27":"Then Bildad the Shuhite answered,"}},{"ref":{"bookId":"job","chapter":25,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"world-english-bible-2026-10-27":"“ Dominion and fear are with him. He makes peace in his high places."}},{"ref":{"bookId":"job","chapter":25,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"world-english-bible-2026-10-27":"Can his armies be counted? On whom does his light not arise?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"world-english-bible-2026-10-27":"How then can man be just with God? Or how can he who is born of a woman be clean?"}},{"ref":{"bookId":"job","chapter":25,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"world-english-bible-2026-10-27":"Behold, even the moon has no brightness, and the stars are not pure in his sight;"}},{"ref":{"bookId":"job","chapter":25,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"world-english-bible-2026-10-27":"How much less man, who is a worm, and the son of man, who is a worm!”"}}]}
