{"schemaVersion":2,"corpusId":"world-english-bible","editionId":"world-english-bible-2026-10-27","packageId":"pkg-ebible-web-2026-10-27","datasetId":"dataset:world-english-bible:2026-10-27:d2a7c9640820003d8ed475ce6d92cc990b0447fe96ce72fd0df17c0dac9d95fe","sourceArtifactId":"artifact:ebible:engwebp:usfm:2026-10-27","sourcePath":"20-PSAengwebp.usfm#chapter=121","bookId":"psalms","chapter":121,"verses":[{"ref":{"bookId":"psalms","chapter":121,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"world-english-bible-2026-10-27":"I will lift up my eyes to the hills. Where does my help come from?"}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"world-english-bible-2026-10-27":"My help comes from the LORD, who made heaven and earth."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"world-english-bible-2026-10-27":"He will not allow your foot to be moved. He who keeps you will not slumber."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"world-english-bible-2026-10-27":"Behold, he who keeps Israel will neither slumber nor sleep."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"world-english-bible-2026-10-27":"The LORD is your keeper. The LORD is your shade on your right hand."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"world-english-bible-2026-10-27":"The sun will not harm you by day, nor the moon by night."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"world-english-bible-2026-10-27":"The LORD will keep you from all evil. He will keep your soul."}},{"ref":{"bookId":"psalms","chapter":121,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"world-english-bible-2026-10-27":"The LORD will keep your going out and your coming in, from this time forward, and forever more."}}]}
