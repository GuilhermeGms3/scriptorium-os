{"schemaVersion":2,"corpusId":"world-english-bible","editionId":"world-english-bible-2026-10-27","packageId":"pkg-ebible-web-2026-10-27","datasetId":"dataset:world-english-bible:2026-10-27:d2a7c9640820003d8ed475ce6d92cc990b0447fe96ce72fd0df17c0dac9d95fe","sourceArtifactId":"artifact:ebible:engwebp:usfm:2026-10-27","sourcePath":"20-PSAengwebp.usfm#chapter=114","bookId":"psalms","chapter":114,"verses":[{"ref":{"bookId":"psalms","chapter":114,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"world-english-bible-2026-10-27":"When Israel went out of Egypt, the house of Jacob from a people of foreign language,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"world-english-bible-2026-10-27":"Judah became his sanctuary, Israel his dominion."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"world-english-bible-2026-10-27":"The sea saw it, and fled. The Jordan was driven back."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"world-english-bible-2026-10-27":"The mountains skipped like rams, the little hills like lambs."}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"world-english-bible-2026-10-27":"What was it, you sea, that you fled? You Jordan, that you turned back?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"world-english-bible-2026-10-27":"You mountains, that you skipped like rams? You little hills, like lambs?"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"world-english-bible-2026-10-27":"Tremble, you earth, at the presence of the Lord, at the presence of the God of Jacob,"}},{"ref":{"bookId":"psalms","chapter":114,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"world-english-bible-2026-10-27":"who turned the rock into a pool of water, the flint into a spring of waters."}}]}
