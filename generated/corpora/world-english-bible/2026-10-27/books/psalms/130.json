{"schemaVersion":2,"corpusId":"world-english-bible","editionId":"world-english-bible-2026-10-27","packageId":"pkg-ebible-web-2026-10-27","datasetId":"dataset:world-english-bible:2026-10-27:d2a7c9640820003d8ed475ce6d92cc990b0447fe96ce72fd0df17c0dac9d95fe","sourceArtifactId":"artifact:ebible:engwebp:usfm:2026-10-27","sourcePath":"20-PSAengwebp.usfm#chapter=130","bookId":"psalms","chapter":130,"verses":[{"ref":{"bookId":"psalms","chapter":130,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"world-english-bible-2026-10-27":"Out of the depths I have cried to you, LORD."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"world-english-bible-2026-10-27":"Lord, hear my voice. Let your ears be attentive to the voice of my petitions."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"world-english-bible-2026-10-27":"If you, LORD, kept a record of sins, Lord, who could stand?"}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"world-english-bible-2026-10-27":"But there is forgiveness with you, therefore you are feared."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"world-english-bible-2026-10-27":"I wait for the LORD. My soul waits. I hope in his word."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"world-english-bible-2026-10-27":"My soul longs for the Lord more than watchmen long for the morning, more than watchmen for the morning."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"world-english-bible-2026-10-27":"Israel, hope in the LORD, for there is loving kindness with the LORD. Abundant redemption is with him."}},{"ref":{"bookId":"psalms","chapter":130,"verseStart":8,"verseEnd":8},"verse":8,"translations":{"world-english-bible-2026-10-27":"He will redeem Israel from all their sins."}}]}
