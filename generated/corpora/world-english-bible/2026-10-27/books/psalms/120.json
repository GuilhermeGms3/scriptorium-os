{"schemaVersion":2,"corpusId":"world-english-bible","editionId":"world-english-bible-2026-10-27","packageId":"pkg-ebible-web-2026-10-27","datasetId":"dataset:world-english-bible:2026-10-27:d2a7c9640820003d8ed475ce6d92cc990b0447fe96ce72fd0df17c0dac9d95fe","sourceArtifactId":"artifact:ebible:engwebp:usfm:2026-10-27","sourcePath":"20-PSAengwebp.usfm#chapter=120","bookId":"psalms","chapter":120,"verses":[{"ref":{"bookId":"psalms","chapter":120,"verseStart":1,"verseEnd":1},"verse":1,"translations":{"world-english-bible-2026-10-27":"In my distress, I cried to the LORD. He answered me."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":2,"verseEnd":2},"verse":2,"translations":{"world-english-bible-2026-10-27":"Deliver my soul, LORD, from lying lips, from a deceitful tongue."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":3,"verseEnd":3},"verse":3,"translations":{"world-english-bible-2026-10-27":"What will be given to you, and what will be done more to you, you deceitful tongue?"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":4,"verseEnd":4},"verse":4,"translations":{"world-english-bible-2026-10-27":"Sharp arrows of the mighty, with coals of juniper."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":5,"verseEnd":5},"verse":5,"translations":{"world-english-bible-2026-10-27":"Woe is me, that I live in Meshech, that I dwell among the tents of Kedar!"}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":6,"verseEnd":6},"verse":6,"translations":{"world-english-bible-2026-10-27":"My soul has had her dwelling too long with him who hates peace."}},{"ref":{"bookId":"psalms","chapter":120,"verseStart":7,"verseEnd":7},"verse":7,"translations":{"world-english-bible-2026-10-27":"I am for peace, but when I speak, they are for war."}}]}
