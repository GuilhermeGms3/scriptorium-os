# Opcional: habilita acervo compartilhado pelo backend Node local.
# Sem esta variável, o aplicativo continua usando OPFS no navegador.
# Docker configura /app/workspace automaticamente via compose.yaml.
# Um runtime por acervo: workspace.lock recusa um segundo processo (Vite/Windows ou Docker/Linux)
# enquanto o primeiro estiver aberto; um lock sem sinal há mais de 2 minutos é recuperado.
# SCRIPTORIUM_WORKSPACE_DIR=./data/workspace

# Companion local para tradução; no Docker, o Compose usa o nome do serviço.
# SCRIPTORIUM_SEMANTIC_URL=http://127.0.0.1:8018
